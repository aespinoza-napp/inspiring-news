BACKEND_URL=http://127.0.0.1:8000

# The backend's API key, needed whenever backend/.env sets
# STORAGE_API_KEY: every analysis, ingestion, graph and storage endpoint
# then requires it, and every route in src/app/api/ sends it. Read
# server-side, never sent to the browser.
# STORAGE_API_KEY=

# The address the public site is served on, for the absolute links in
# /reader/feed.xml and /reader/sitemap.xml (e.g. https://news.example.org).
# Unset, they use the address each request came in on, as Caddy forwards
# it - right behind Caddy and in development alike.
# PUBLIC_SITE_URL=
