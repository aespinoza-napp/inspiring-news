{
  "name": "news-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable news aggregation and publishing pipeline",
  "scripts": {
    "dev": "docker-compose up --build",
    "dev:source": "ts-node backend/services/source/index.ts",
    "dev:news": "ts-node backend/services/news/index.ts",
    "dev:fact-check": "ts-node backend/services/fact-check/index.ts",
    "dev:nlp": "ts-node backend/services/nlp/index.ts",
    "dev:content": "ts-node backend/services/content/index.ts",
    "dev:media": "ts-node backend/services/media/index.ts",
    "dev:qa": "ts-node backend/services/qa/index.ts",
    "dev:publishing": "ts-node backend/services/publishing/index.ts",
    "dev:analytics": "ts-node backend/services/analytics/index.ts",
    "dev:frontend": "cd frontend && next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "workspaces": [
    "frontend",
    "backend/services/*"
  ],
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "ts-node": "^10.9.2",
    "eslint": "^8.57.0"
  }
}
