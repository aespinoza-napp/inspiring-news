# The values more than one component needs, in one place.
#
#   cp .env_global.example .env_global     (or just run ./scripts/init_env.sh)
#   ./scripts/init_env.sh                  writes them where each component reads them
#
# init_env.sh creates backend/.env and frontend/.env.local from their
# examples when they are missing, then sets only the keys below in them -
# anything else you edited there is left alone. Run it again after
# changing this file; ./scripts/dev.sh runs it on every start.
#
# Everything not listed here (thresholds, weights, models of inference/)
# keeps its own file: backend/.env-example documents each one.

# ---------------------------------------------------------------------
# Secrets - left empty, init_env.sh generates them and writes them back
# here, so every component and every rerun gets the same value.
# ---------------------------------------------------------------------

# Neo4j's password. Only applies when the database is first created:
# changing it later means recreating the neo4j-data volume
# (docker compose ... down -v deletes it, and every other volume too).
NEO4J_PASSWORD=

# SearXNG's server secret; compose refuses to start without it.
SEARXNG_SECRET=

# The backend's API key, sent by the frontend and the labeller. Empty
# leaves the API open - fine on localhost; set it before exposing the
# backend anywhere. Not generated: an empty value comments the key out.
STORAGE_API_KEY=

# ---------------------------------------------------------------------
# Where the frontend finds the backend
# ---------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------
# The LLM: any OpenAI-compatible endpoint. Defaults to Ollama on this
# machine (`ollama pull llama3.2:3b` once). Inside Docker the backend
# reaches the host's Ollama by itself (docker-compose.yml overrides
# LLM_BASE_URL); this value is for running the backend on the host.
# ---------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# The models that write and review drafts; empty means LLM_MODEL. See
# backend/.env-example for how to build `writer` and `reviewer`.
WRITER_LLM_MODEL=
CORRECTOR_LLM_MODEL=
