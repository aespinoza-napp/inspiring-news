STORAGE_PATH=<your_data_path>

# Three-layer storage lake written by the analysis pipeline
# (raw -> processed -> exploitation). LAKE_ENABLED=false turns the
# persist stage off entirely.
LAKE_PATH=<your_data_path>/lake
LAKE_ENABLED=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

QDRANT_PATH=<your_qdrant_data_path>
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------
# Pipeline thresholds
#
# These are the DEFAULTS. Any single run can override any of them per
# request via the `thresholds` field on POST /analyze and
# POST /analyze/jobs - anything the caller omits falls back to the value
# here. See backend/src/config/thresholds.py.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Security
#
# URL_GUARD blocks server-side fetches of private, loopback, link-local
# and reserved addresses - without it POST /analyze is an HTTP proxy into
# whatever network this runs on, including the compose network holding
# Neo4j and SearXNG. Only disable it for offline tests.
# ---------------------------------------------------------------------
URL_GUARD_ENABLED=true

# Hostnames exempt from the address check, comma-separated JSON list.
# An escape hatch for a staging host on a private network, so nobody
# turns the whole guard off to reach one box.
# URL_GUARD_ALLOWED_HOSTS=["staging.internal"]

# When set, /storage/* requires this in an X-API-Key header. Those
# endpoints return whole article bodies and full lineage. Unset leaves
# them open (fine on localhost; src/main.py warns at startup).
# STORAGE_API_KEY=change-me

# Enrichment
TOPIC_CLASSIFIER_THRESHOLD=0.35
ENTITY_THRESHOLD=0.50
CLAIM_MIN_CONFIDENCE=0.50

# Extraction: shortest body accepted as a real article, in characters
MIN_BODY_LENGTH=500

# Admission filter
TOPIC_MIN_CONFIDENCE=0.35
POSITIVE_IMPACT_MIN_SCORE=0.30

DUPLICATE_THRESHOLD=0.96
RELATEDNESS_THRESHOLD=0.80

# SearXNG must be running locally (see docker/docker-compose.yml) with the
# JSON API enabled (docker/searxng/settings.yml.example).
SEARXNG_URL=http://localhost:8080

# LLM verification: OpenAI-compatible endpoint. Defaults to a local Ollama
# instance (`ollama pull llama3.1` once, then `ollama serve`) - open-source
# and free by default. To use a hosted provider instead (Groq, OpenRouter,
# Together, ...), just change these three values.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

MAX_CLAIMS_PER_ARTICLE=5
MAX_EVIDENCE_PER_CLAIM=5
# Search hits requested per claim, before the pre-rank funnel cuts them
# down to MAX_EVIDENCE_PER_CLAIM. Widen this first when claims come back
# UNVERIFIED for lack of evidence.
EVIDENCE_FETCH_CANDIDATES=8
CLAIM_DEDUP_THRESHOLD=0.92
MIN_EVIDENCE_FOR_VERDICT=1

# EvidenceRanker / ConfidenceScorer weights - tune as needed, each group must
# sum to 1.0. Unlike the thresholds above these are environment-only, and
# deliberately not per-request overridable: letting a caller set one member
# of a group alone would silently de-normalise the scoring function.
RANKING_SEMANTIC_WEIGHT=0.60
RANKING_RECENCY_WEIGHT=0.25
RANKING_RELIABILITY_WEIGHT=0.15
RANKING_DEFAULT_RELIABILITY=0.5
CONFIDENCE_LLM_WEIGHT=0.7
CONFIDENCE_EVIDENCE_WEIGHT=0.3