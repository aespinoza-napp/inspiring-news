# Relative to wherever `uvicorn` is started (backend/ for local dev).
# These three work as-is - point them elsewhere only if you want the
# data on a different disk/volume.
STORAGE_PATH=data

# Three-layer storage lake written by the analysis pipeline
# (raw -> processed -> exploitation). LAKE_ENABLED=false turns the
# persist stage off entirely.
LAKE_PATH=data/lake
LAKE_ENABLED=true

# Required by Settings (no default). Every analysis is written into the
# graph (docs/decisions/graph.md), and docker-compose.yml reads the same
# value for NEO4J_AUTH - which only applies when the database is first
# created, so changing it later means recreating the neo4j-data volume.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Write each finished analysis into Neo4j. Fail-soft either way.
GRAPH_ENABLED=true

SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

QDRANT_PATH=data/vector_db
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------
# Pipeline thresholds
#
# These are the DEFAULTS. Any single run can override any of them per
# request via the `thresholds` field on POST /analyze and
# POST /analyze/jobs - anything the caller omits falls back to the value
# here. See backend/src/config/thresholds.py.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Security
#
# URL_GUARD blocks server-side fetches of private, loopback, link-local
# and reserved addresses - without it POST /analyze is an HTTP proxy into
# whatever network this runs on, including the compose network holding
# Neo4j and SearXNG. Only disable it for offline tests.
# ---------------------------------------------------------------------
URL_GUARD_ENABLED=true

# Hostnames exempt from the address check, comma-separated JSON list.
# An escape hatch for a staging host on a private network, so nobody
# turns the whole guard off to reach one box.
# URL_GUARD_ALLOWED_HOSTS=["staging.internal"]

# The API key. When set, every endpoint but /healthz, /metrics and
# polling a job by id requires it in an X-API-Key header: the analyses
# (minutes of CPU, sometimes a headless browser), ingestion, the graph
# console and /storage/*, which returns whole article bodies. Unset
# leaves them open - fine on localhost; src/main.py warns at startup, and
# docker-compose.prod.yml refuses to start without it. The frontend
# (frontend/.env.local) and the labeller send the same value. Leave the
# line commented rather than empty: an empty key matches no request.
# STORAGE_API_KEY=change-me

# Enrichment
TOPIC_CLASSIFIER_THRESHOLD=0.35
ENTITY_THRESHOLD=0.50
CLAIM_MIN_CONFIDENCE=0.50

# Extraction: shortest body accepted as a real article, in characters
MIN_BODY_LENGTH=500

# Admission filter
TOPIC_MIN_CONFIDENCE=0.35
POSITIVE_IMPACT_MIN_SCORE=0.30

DUPLICATE_THRESHOLD=0.96
RELATEDNESS_THRESHOLD=0.80

# SearXNG must be running locally (see docker/docker-compose.yml) with the
# JSON API enabled (docker/searxng/settings.yml).
SEARXNG_URL=http://localhost:8080

# Not read by the backend: docker-compose.yml passes it to SearXNG as its
# server secret, and refuses to start without it. Kept here so every
# secret lives in one file. Generate one per machine:
#   python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# When SearXNG cannot answer a query, ask DuckDuckGo's keyless HTML page
# directly (src/services/duckduckgo.py). It refuses by IP: on 2026-09-30
# it challenged every request from the development machine, and after a
# challenge it is not asked again for 5 minutes.
DUCKDUCKGO_FALLBACK_ENABLED=true

# LLM verification: OpenAI-compatible endpoint. Defaults to a local Ollama
# instance (`ollama pull llama3.2:3b` once, then `ollama serve`) - open-source
# and free by default, and light enough to run alongside inference/'s models
# on a laptop with no GPU. To use a hosted provider instead (Groq, OpenRouter,
# Together, ...), just change these three values.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
# The model that writes drafts (/drafts); empty means LLM_MODEL. Not
# llama3.2:3b: measured 2026-10-15 it cited no source in four drafts and
# stated an unverified claim as fact. Serve it with a 16k context (a
# Modelfile's num_ctx) or long prompts are cut without a word. Measured
# 2026-10-19: qwen3.5:4b, thinking off, cited every sentence, stated
# neither withheld claim, ~3 minutes a draft on a CPU
# (docs/decisions/writing.md, "The model, again"; scripts/try_writer_model.py):
# WRITER_LLM_MODEL=writer      (from the Modelfile below, FROM qwen3.5:4b)
# Seconds per draft. 300 suits a GPU; a 7B writer on the 4-vCPU VM is
# estimated at ~10 minutes a draft, so about 900 there.
# WRITER_LLM_TIMEOUT=300
# Serving it with a 16k context, for the writer only (no download beyond
# the base model's own):
#   printf 'FROM qwen3.5:4b\nPARAMETER num_ctx 16384\n' > Modelfile
#   ollama pull qwen3.5:4b && ollama create writer -f Modelfile
# (or ./scripts/stack.sh write writer, which pulls a missing model and
# loads it only if the machine has room)
# The model that reviews a draft and proposes its correction; empty means
# LLM_MODEL. Measured 2026-10-19 on the seeded drafts (scripts/
# try_reviewer_model.py): qwen3.5:9b found all 10 planted defects and
# parsed every metric, ~3.5 min a review on a CPU; qwen3.5:4b 6 of 10,
# llama3.2:3b 5 of 10 (docs/decisions/writing.md, "The reviewer,
# measured"). A different model from the writer on purpose. A review
# reads the draft and its sources, so it needs the long context too:
# CORRECTOR_LLM_MODEL=reviewer (from a Modelfile FROM qwen3.5:9b,
# PARAMETER num_ctx 16384, as for the writer)
# A hybrid reasoning model (Qwen3.5) thinks before every answer unless
# the request says not to; per model, as JSON (src/config/settings.py):
# LLM_REASONING_EFFORT={"writer": "none", "reviewer": "none", "qwen3.5:4b": "none", "qwen3.5:9b": "none"}
# The verifier stays llama3.2:3b (LLM_MODEL above): on the custom set's
# train half qwen3.5:4b read even the annotator's own pages 20 points
# worse, and slower (docs/decisions/evaluation.md, "Choosing the models").
# Production only (docker-compose.prod.yml reads these, the backend does
# not): the base model ollama-pull serves as WRITER_LLM_MODEL at
# WRITER_NUM_CTX tokens of context, and Ollama's memory cap, sized for
# the largest model since only one is loaded at a time.
# WRITER_LLM_BASE=qwen3.5:4b
# CORRECTOR_LLM_BASE=qwen3.5:9b
# WRITER_NUM_CTX=16384
# OLLAMA_MEM_LIMIT=8g
# How the review's correction is asked for: rewrite (the whole article
# again) or edits (only the changes, applied where each passage occurs
# once, then checked like any proposal). Edits were slower on a real
# draft, which changes nearly every sentence. docs/decisions/performance.md.
REVIEW_CORRECTION=rewrite
# Per call of the AI selection on /discover, which scores ten candidates
# at a time and writes a reason for each: longer than one verdict.
AI_SELECTION_TIMEOUT=240

MAX_CLAIMS_PER_ARTICLE=5
MAX_EVIDENCE_PER_CLAIM=5
# Search hits requested per claim, before the pre-rank funnel cuts them
# down to MAX_EVIDENCE_PER_CLAIM. Widen this first when claims come back
# UNVERIFIED for lack of evidence.
EVIDENCE_FETCH_CANDIDATES=8
CLAIM_DEDUP_THRESHOLD=0.92
MIN_EVIDENCE_FOR_VERDICT=1
# The second look: a claim whose first verdict is UNVERIFIED, or below
# this confidence, is searched again with follow-up queries the model
# writes from what was missing (services/fact_checker/second_look.py).
# Decided on the custom set's train half (docs/decisions/evaluation.md,
# "The second look"); per run as `second_look_enabled` too.
SECOND_LOOK_ENABLED=false
SECOND_LOOK_BELOW_CONFIDENCE=0.5
# What the verifier reads of each source: passages (the sentences carrying
# the claim's terms) or head (the page's first VERIFIER_EXCERPT_CHARS
# characters, every run before 2026-10-21, at 1500). Per run as
# verifier_excerpt / verifier_excerpt_chars. docs/decisions/performance.md.
VERIFIER_EXCERPT=passages
VERIFIER_EXCERPT_CHARS=700

# EvidenceRanker / ConfidenceScorer weights - tune as needed, each group must
# sum to 1.0. Unlike the thresholds above these are environment-only, and
# deliberately not per-request overridable: letting a caller set one member
# of a group alone would silently de-normalise the scoring function.
RANKING_SEMANTIC_WEIGHT=0.45
RANKING_LEXICAL_WEIGHT=0.20
RANKING_RECENCY_WEIGHT=0.20
RANKING_RELIABILITY_WEIGHT=0.15
RANKING_DEFAULT_RELIABILITY=0.5
CONFIDENCE_LLM_WEIGHT=0.7
CONFIDENCE_EVIDENCE_WEIGHT=0.3

# How long an analysis stays cached, in hours (0 = never expires). A
# verdict rests on that day's web search: a week, not forever.
# ANALYSIS_CACHE_TTL_HOURS=168
# Finished jobs kept in memory beside the job journal; older ones are
# read back from the journal by id.
# JOB_STORE_KEEP_FINISHED=200
