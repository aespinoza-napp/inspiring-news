STORAGE_PATH=<your_data_path>

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
OPENAI_API_KEY=your_openai_key_here

SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

QDRANT_PATH=<your_qdrant_data_path>
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=BAAI/bge-m3

DUPLICATE_THRESHOLD=0.96
RELATEDNESS_THRESHOLD=0.80

# SearXNG must be running locally (see docker/docker-compose.yml) with the
# JSON API enabled (docker/searxng/settings.yml.example).
SEARXNG_URL=http://localhost:8080

# LLM verification: OpenAI-compatible endpoint. Defaults to a local Ollama
# instance (`ollama pull llama3.1` once, then `ollama serve`) so this is
# free/open-source by default. To use a hosted provider instead (Groq,
# OpenRouter, Together, real OpenAI), just change these three values.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

MAX_CLAIMS_PER_ARTICLE=5
MAX_EVIDENCE_PER_CLAIM=5