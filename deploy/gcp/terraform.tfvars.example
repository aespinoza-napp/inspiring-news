# Copy to terraform.tfvars (gitignored) and fill in. See
# docs/decisions/deployment.md for what each choice costs.
project_id = "your-project-id"

# The first deploy (deployment.md, "The first deploy: the universe and
# /discover"): the readers' universe and the newsroom's /discover on an
# 8 GB machine, Groq as the LLM. "full" is the whole pipeline with its own
# model, on 16 GB.
stack        = "lite"
groq_api_key = "gsk_..."   # console.groq.com; the AI selection and analyses need it

# No domain yet: the universe at <ip>.sslip.io and the newsroom at
# admin.<ip>.sslip.io, both over HTTPS. With domains, set them instead
# (bare hostnames; their A records -> terraform output external_ip,
# before the VM's first boot finishes, so Caddy gets its certificates).
free_hostnames = true
# domain          = "admin.example.org"      # the newsroom, behind the password
# universe_domain = "universe.example.org"   # the readers' universe, open

# region       = "europe-southwest1"   # Madrid
# zone         = "europe-southwest1-a"
# machine_type = ""                    # e2-standard-2 for lite, e2-standard-4 for full
# repo_ref     = "main"
# alert_email  = "you@example.org"
