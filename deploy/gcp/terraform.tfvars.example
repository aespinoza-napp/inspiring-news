# Copy to terraform.tfvars (gitignored) and fill in. See
# docs/decisions/deployment.md for what each choice costs.
project_id = "your-project-id"

# region       = "europe-southwest1"   # Madrid
# zone         = "europe-southwest1-a"
# machine_type = "e2-standard-4"       # 16 GB is the floor
# repo_ref     = "main"
# A bare hostname. Create its A record (terraform output external_ip)
# before the VM's first boot finishes, so Caddy gets its certificate.
# Without one, only /healthz is public: use terraform output ui_tunnel.
# domain       = "factcheck.example.org"
# alert_email  = "you@example.org"
