use_default_settings:
  engines:
    # Explicit allowlist, not the full default roster (~40 engines).
    #
    # Every engine SearXNG enables by default is queried on every claim
    # the fact-checker verifies, and most of them either cannot answer or
    # are actively blocked from this network. Measured, one engine at a
    # time, against a freshly-restarted instance:
    #
    #   bing        10 results     google       10 results
    #   brave       20 results     yep          20 results
    #   bing news   10 results
    #
    #   duckduckgo  timeout / CAPTCHA / HTTP 403
    #   startpage   HTTP connection error (and a JSON parse error before that)
    #   qwant       CAPTCHA
    #   google news CAPTCHA
    #   yahoo       parsing error
    #   wikidata    engine timeout on every call
    #   mwmbl       answered once, then timed out on every later call
    #
    # Keeping the broken ones cost more than the log spam they produced:
    # each one burns its slice of the per-search budget and holds the
    # request open for the full engine timeout, so every claim in every
    # article waited on engines that were never going to answer. Worse,
    # the handful that *do* work were then hammered hard enough to be
    # suspended for rate-limiting ("Suspended: too many requests"), at
    # which point a search returned zero results and every claim came
    # back UNVERIFIED - the fact-checker silently became a no-op.
    #
    # bing/google/brave/yep are four independent indexes, which is also
    # what the fact-checker wants: corroboration from sources that do not
    # share a crawler.
    #
    # 2026-09-28: this allowlist had never reached the live settings.yml,
    # which was still `use_default_settings: true` - the full roster, and
    # the DuckDuckGo CAPTCHAs and Wikidata timeouts of the 2026-09-25
    # measurement (docs/decisions/retrieval.md). Added the same day, each
    # measured on three claim-shaped queries (en, es, en):
    #
    #   arxiv             10/10/10 results, 0.6-1.3s
    #   crossref          20/19/18 results, 1.0-1.8s
    #   semantic scholar  10/10/10 results, 0.6-1.7s
    #   pubmed            rate-limited by NCBI after one query (no API
    #                     key); fails in 0.2s while suspended, so kept
    #   wikipedia         see its override below
    #
    #   openalex          rate-limited after one query without a
    #                     `mailto` - left out
    #
    # APIs rather than scraped result pages: nothing to CAPTCHA, and they
    # still answer when the web engines are suspended - which on
    # 2026-09-25 was most of the time.
    #
    # Re-measure before trusting this list on a different network - these
    # are blocked/allowed by where the container runs, not by SearXNG.
    keep_only:
      - bing
      - google
      - brave
      - yep
      - bing news
      - wikipedia
      - arxiv
      - crossref
      - semantic scholar
      - pubmed

# keep_only (above) narrows the roster; it does not switch anything on.
# bing, google and yep all ship `disabled: true` in SearXNG's defaults,
# meaning "available, but off unless a user enables it in preferences" -
# and the fact-checker is not a user with preferences, it calls the JSON
# API anonymously. Without these overrides the allowlist collapsed to the
# two engines that happen to be on by default (brave, bing news), so a
# single rate-limit suspension on brave took the whole search to zero.
engines:
  - name: bing
    disabled: false
  - name: google
    disabled: false
  - name: yep
    disabled: false

  # By default Wikipedia only fills the infobox, which SearxngClient never
  # reads: it answered 0 results on every query until "list" was added.
  - name: wikipedia
    display_type: ["infobox", "list"]

  # The science engines live in the `science` category, and SearxngClient
  # sends no `categories` - SearXNG then asks `general` only, so without
  # `general` here they were never queried at all.
  #
  # weight 0.5: a paper is evidence for a science claim, noise for most
  # others, and Crossref answers ~20 records for anything - enough to fill
  # the backend's top SEARXNG_MAX_RESULTS by itself. Halved, a web result
  # at the same position outranks it, and the papers still come through
  # whole when the web engines are rate-limited. The pertinence gate cuts
  # the off-subject ones either way.
  - name: arxiv
    categories: [general, science]
    weight: 0.5
  - name: crossref
    categories: [general, science]
    weight: 0.5
    disabled: false
    # Its default is 30s, far over request_timeout below; measured 1.0-1.8s.
    timeout: 3.0
  - name: semantic scholar
    categories: [general, science]
    weight: 0.5
  - name: pubmed
    categories: [general, science]
    weight: 0.5

general:
  instance_name: "Inspiring News Fact-Checker"

search:
  formats:
    - html
    - json   # required: SearxngClient (backend/src/services/search.py) calls ?format=json

outgoing:
  # SearXNG's own default. This was 8s here, against a short timeout
  # recording a slow answer as a failure and suspending the engine - but
  # the slow engines were the dead ones (DuckDuckGo, Wikidata), which are
  # gone. Every engine above answered within 2.1s on 2026-09-28; an 8s
  # timeout only made each query wait longer on an engine that was down.
  # If one starts showing "Suspended: timeout" on /scraper's Source
  # health panel, raise that engine's own `timeout`, not this.
  request_timeout: 3.0
  max_request_timeout: 6.0

server:
  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
  secret_key: "REPLACE_WITH_A_RANDOM_SECRET"
  limiter: false   # internal-only instance; re-enable + add Valkey/Redis if ever exposed publicly
