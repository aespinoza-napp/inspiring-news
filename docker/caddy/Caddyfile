# The only door from the internet into the production stack
# (docker-compose.gcp.yml). The backend and the frontend themselves
# listen on the VM's loopback and the compose network.
#
# SITE_ADDRESS is the Terraform variable `domain`, rendered into
# backend/.env by deploy/gcp/vm/bootstrap.sh. With a domain whose A
# record points at the VM, Caddy fetches and renews its certificate by
# itself, redirects HTTP to HTTPS, and serves the site. Without one it is
# ":80", plain HTTP, and only /healthz answers: the UI is then reached
# through an IAP tunnel (docs/decisions/deployment.md, "The front door").
{$SITE_ADDRESS::80} {
	# For the uptime check (deploy/gcp/monitoring.tf) and scripts/smoke.sh.
	# Says which dependency is down and how, never the error text. No
	# password: it is the one backend endpoint open by design
	# (backend/tests/api/test_api_key.py::OPEN_ENDPOINTS).
	handle /healthz {
		reverse_proxy backend:8000
	}

	# The UI, behind a password, and only over HTTPS.
	#
	# The password because the frontend's server routes attach the API
	# key to every call they forward (frontend/src/app/api/): an open
	# frontend is the backend with the key already in it - the Cypher
	# console, ingestion, minutes of CPU per analysis. The key keeps
	# anyone from calling the backend directly; this keeps anyone from
	# calling it through the frontend. One user, `editor`; the password
	# is generated by Terraform (`terraform output -raw site_password`),
	# and only its bcrypt hash reaches the VM.
	#
	# HTTPS only because basic auth sends the password in every request:
	# over plain HTTP it would cross the internet readable. Without a
	# domain there is no HTTPS, so this never matches and the UI is not
	# served at all - a closed fallback, not a cleartext one.
	@https protocol https
	handle @https {
		basic_auth {
			{$SITE_USER:editor} {$SITE_PASSWORD_HASH}
		}
		reverse_proxy frontend:3000
	}

	# The backend's API is never forwarded: everything but /healthz goes
	# through the frontend's server routes or an SSH tunnel.
	handle {
		respond "Not here. With a domain set, the site is served over HTTPS; without one, through an IAP tunnel (terraform output ui_tunnel)." 404
	}
}
