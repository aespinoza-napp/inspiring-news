# The only door from the internet into the production stack
# (docker-compose.gcp.yml). The backend and the frontend themselves
# listen on the VM's loopback and the compose network.
#
# Two sites: the newsroom's (this first block: the frontend, behind a
# password) and the readers' universe (the last block, open).
#
# SITE_ADDRESS is the Terraform variable `domain` (or, with
# free_hostnames, `admin.<ip>.sslip.io`), rendered into backend/.env by
# deploy/gcp/vm/bootstrap.sh. With a name whose A record points at the
# VM, Caddy fetches and renews its certificate by itself, redirects HTTP
# to HTTPS, and serves the site. Without one it is ":80", plain HTTP, and
# only /healthz answers: the UI is then reached through an IAP tunnel
# (docs/decisions/deployment.md, "The front door").
{$SITE_ADDRESS::80} {
	# For the uptime check (deploy/gcp/monitoring.tf) and scripts/smoke.sh.
	# Says which dependency is down and how, never the error text. No
	# password: it is the one backend endpoint open by design
	# (backend/tests/api/test_api_key.py::OPEN_ENDPOINTS).
	handle /healthz {
		reverse_proxy backend:8000
	}

	# The reader view, open to anyone: the pages, their proxies, and
	# the compiled JS/CSS every page loads. Safe without the password
	# because each of these reaches only the backend's /reader routes,
	# which are open by design (test_api_key.py::OPEN_ENDPOINTS):
	# publishable articles, their lead and the checks behind them. The
	# static bundles hold no key - it is read on the server, never shipped.
	# Served on plain HTTP too when there is no domain: nothing here is
	# secret, and no password crosses the network for it. Everything
	# else the reader page links to (the operator pages) still asks for
	# the password below.
	# The readers' news map and the day's news (docs/decisions/news-map.md)
	# are the same kind of page: their one proxy, /api/map/*, forwards only
	# the backend's four /map routes, open by design like /reader's. A
	# reader's account is too (/account): its proxy forwards only the seven
	# account routes, whose capability is the session cookie, not the
	# password (src/api/account_routes.py).
	@reader path /reader /reader/* /api/reader/* /map /map/* /today /for-you /api/map/* /account /api/account/* /_next/static/* /favicon.ico
	handle @reader {
		reverse_proxy frontend:3000
	}

	# The rest of the UI, behind a password, and only over HTTPS.
	#
	# The password because the frontend's server routes attach the API
	# key to every call they forward (frontend/src/app/api/): an open
	# frontend is the backend with the key already in it - the Cypher
	# console, ingestion, minutes of CPU per analysis. The key keeps
	# anyone from calling the backend directly; this keeps anyone from
	# calling it through the frontend. One user, `editor`; the password
	# is generated by Terraform (`terraform output -raw site_password`),
	# and only its bcrypt hash reaches the VM.
	#
	# HTTPS only because basic auth sends the password in every request:
	# over plain HTTP it would cross the internet readable. Without a
	# domain there is no HTTPS, so this never matches and the UI is not
	# served at all - a closed fallback, not a cleartext one.
	@https protocol https
	handle @https {
		basic_auth {
			{$SITE_USER:editor} {$SITE_PASSWORD_HASH}
		}
		reverse_proxy frontend:3000
	}

	# The backend's API is never forwarded: everything but /healthz goes
	# through the frontend's server routes or an SSH tunnel.
	handle {
		respond "Not here. With a domain set, the site is served over HTTPS; without one, through an IAP tunnel (terraform output ui_tunnel)." 404
	}
}

# The readers' universe (universe/, docs/decisions/news-map.md, "The
# universe"), at an address of its own and open to anyone, like /reader.
# A static site built into this image (docker/caddy.Dockerfile) that reads
# /api/map and /api/account from its own origin, so the session cookie is
# the universe's and the backend is reached without the frontend: its
# proxies forward only four /map routes, not the photos or For you.
#
# UNIVERSE_ADDRESS is rendered by deploy/gcp/vm/bootstrap.sh from
# Terraform's `universe_domain`, else `<ip>.sslip.io` with free_hostnames,
# else `http://<ip>` (plain HTTP: browsing and search work, signing in
# does not, the cookie being Secure). Unset (a laptop, the emulator check)
# it is a name nothing resolves to, so the block is inert.
{$UNIVERSE_ADDRESS:http://universe.invalid} {
	# The map document is ~210 KB of JSON; compressed it is a fraction,
	# and egress is what a visit costs.
	encode zstd gzip

	# The uptime check asks the IP when there is no domain, which lands
	# here (deploy/gcp/monitoring.tf).
	handle /healthz {
		reverse_proxy backend:8000
	}

	# The universe's two backends, and nothing else of the API. Every
	# backend route under /map and /account is open by design - the map is
	# public, an account's capability is its session cookie - which
	# backend/tests/test_deployment_config.py holds against
	# test_api_key.py::OPEN_ENDPOINTS. Caddy sets X-Forwarded-For from the
	# connection, which is what the search and sign-in limits count by.
	handle /api/map/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle /api/account/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle /api/* {
		respond "Not here: the universe reaches only /api/map and /api/account." 404
	}

	# Astro names its bundles by their content: a new build is a new name.
	@bundles path /_astro/*
	header @bundles Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv/universe
		file_server
	}
}
