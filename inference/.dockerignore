# Build context for docker/inference.Dockerfile.
#
# Mirrors backend/.dockerignore, and matters more here than there: the
# host virtualenv in this directory holds torch and the transformers
# stack. Without this line, `COPY . .` shipped a Windows/host .venv into
# a Linux image on top of the one `uv sync` had just built - measured:
# 6.89GB with it, 3.7GB without.
.venv/

# Downloaded model weights, if anything ever caches them here rather
# than in HF_HOME (/models, a named volume - see docker-compose.yml).
models/

# Laya's fine-tuned checkpoints (scripts/laya_train_all.sh), ~1.3 GB
# each. Mounted read-only by docker-compose.yml instead: baked in, three
# of them made a 4.07 GB build context and a 9.83 GB image, and the
# export ran the disk out of space (2026-10-28).
checkpoints/

__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets are supplied at runtime, never baked into a layer.
.env

.git/
.gitignore
